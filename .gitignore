.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.coverage
htmlcov/
*.egg-info/
build/
dist/
.env
# generated archives and keys in the working tree
*.vxdna
key.txt
*.bin
# V0.1 compatibility fixtures are intentional binary test inputs
!tests/fixtures/**/*.bin
# VNX-DNA 2.0 compatibility fixtures (generated by research/v3/make_v2_fixtures.py with tag v2.0.0)
!tests/fixtures/**/*.vxdna
# V2 generated data: packed strands, DNA indexes, partial outputs and checkpoints, benchmark scratch
*.vxs
*.vxidx
*.partial
*.partial.ckpt
*.partial.idx
*.fastq
# committed fixtures: the physical-interface examples are test inputs checked against SHA-256 in their manifests
!experiments/v6/physical/examples/**/*.fastq
clusters.jsonl

# local benchmark scratch data (never committed)
.bench-tmp/

# V5 native aligner build outputs (built by pip install or python -m vnxdna.v5.native_alignment build)
src/vnxdna/v5/*.so
src/vnxdna/v5/native/*.so
# V6 native read parser and RS decoder (pip install, or python -m vnxdna.v6.native_reads build / native_rs build)
src/vnxdna/v6/native/*.so
src/vnxdna/v6/*.so
# V7 native read-clustering kernels (pip install, or python -m vnxdna.native.cluster build)
src/vnxdna/native/c/*.so
src/vnxdna/native/*.so

# throwaway install-test virtual environments
.tmp-venvs/
# fuzz campaign outputs (fuzz/run.sh): working corpora, crash files, logs
fuzz/out/

# runtime artefact written by a third-party benchmark codec
seen_barocdes.json
