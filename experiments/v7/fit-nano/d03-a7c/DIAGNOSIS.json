 "decision": "DEV_LOOK_2_BLOCKED \u2014 FIT PRE-CHECK INADEQUATE",
 "evidence_class": "PUBLIC-DATA-DERIVED FIT reads vs SIMULATED reads from the a7c candidates (in sample; not validation)",
 "m10_rule_text_note": "validate.compare_params prints its rule as '... + 0.02' (abs_floor) but the formula never used abs_floor; the formula (5 SE + 8 % relative) is what produced every M10 result in V7 and is unchanged; the rule text is corrected (no metric change)",
 "mechanisms": {
  "M1": {
   "class": "1 genuine model misspecification (stratified), revealed by an aggregate metric",
   "finding": "interior insertion bases match (sim/fit 0.99-1.01 in every decile) but insertions after the last reference base are almost absent from the simulation (sim/fit 0.01-0.30; 1-31 % of real inserted bases are at the read end, most in bwd). The calibration matches interior events only; M1 counts all inserted bases, so the aggregate is 2-5 % low in sample and failed at DEV look 1 for bwd (5-6 %)",
   "remedy": "a read-end (trailing) insertion component"
  },
  "M10": {
   "class": "mixed: 5 implementation/estimator bias (censoring), 4 metric statistics (SE), 3 sparse bins, 6 identifiability",
   "finding": [
    "deletion tail_mean: refits low (bias up to 15 %, z up to 11.5): runs are tallied up to max_run 16 with longer runs folded into the last bin, so a tail mean near 12-15 is censored",
    "refit seed-to-seed SD is 1.4-7x the bootstrap SE that M10 uses: the bootstrap over references omits the Monte-Carlo noise of the simulation calibration",
    "empirical pmf bins with target ~1e-4 have bootstrap SE ~0, so any refit difference fails",
    "fast models (min_run 2 + substitution context; hp_sub_fixed): substitution matrix and context are biased in the refit (z up to 76): not re-identifiable",
    "hac-bwd: 5/6 replicates pass; its precheck M10 failure is plausibly noise"
   ],
   "remedy": "V8 preregistration candidates: uncensored tail tally, calibration-aware SE, sparse-bin rule, substitution-context identifiability constraint. Not applied to V7 (no threshold changed after seeing results)."
  },
  "M3": {
   "class": "1 genuine model misspecification",
   "finding": "real reads carry co-located insertion+deletion pairs (16.6-22.8 % of insertions have a deletion within 2 reference bases vs 4.1-8.2 % simulated); the /2 model draws insertions and deletions independently, so balanced (zero-drift) reads at low edit distance are under-produced (HAC: 28.9-29.1 % real vs 25.7-26.5 % simulated). Per-read I, D, S means and dispersions match within a few %.",
   "remedy": "a paired-indel (shift) process; a schema change, out of V7 scope"
  },
  "M6r": {
   "class": "resolved by the per-run-length multiplier",
   "finding": "passes in sample for all four candidates (FIT, both halves)"
  }
 },
