{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "record.schema.json",
  "title": "VNX-DNA physical validation run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "record_id",
    "evidence_classification",
    "synthesis",
    "sample",
    "storage",
    "sequencing",
    "decode",
    "result",
    "attestations"
  ],
  "properties": {
    "record_version": {
      "const": "1"
    },
    "record_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_classification": {
      "anyOf": [
        {
          "enum": [
            "REAL PHYSICAL RESULT",
            "SIMULATED RESULT",
            "SYNTHETIC SOFTWARE TEST"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "REAL PHYSICAL RESULT only with synthesis, sequencing and FASTQ checksum evidence"
    },
    "statement": {
      "type": [
        "string",
        "null"
      ]
    },
    "synthesis": {
      "$ref": "synthesis.schema.json"
    },
    "sample": {
      "$ref": "sample.schema.json"
    },
    "storage": {
      "$ref": "storage.schema.json"
    },
    "sequencing": {
      "$ref": "sequencing.schema.json"
    },
    "decode": {
      "$ref": "decode.schema.json"
    },
    "result": {
      "$ref": "result.schema.json"
    },
    "attestations": {
      "$ref": "attestations.schema.json"
    }
  }
}
