{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result.schema.json",
  "title": "Verification result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expected_sha256",
    "files_expected",
    "files_recovered",
    "recovered_sha256",
    "verification_result"
  ],
  "properties": {
    "recovered_sha256": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_sha256": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "verification_result": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "SUCCESS",
        "PARTIAL",
        "FAILURE",
        null
      ],
      "description": "SUCCESS requires recovered == expected"
    },
    "files_expected": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "files_recovered": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
